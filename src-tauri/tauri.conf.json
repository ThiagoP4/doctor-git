{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doctor-git",
  "version": "0.1.0",
  "identifier": "com.doctorgit.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
      "title": "Doctor Git",
        "width": 500,      
        "height": 350,     
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "center": false,
        "x": 3000, 
        "y": 2000,
        "shadow": false,
        "skipTaskbar": true 
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
